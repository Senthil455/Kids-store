# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
APP_TIMEZONE=UTC

# Database
MONGO_URI=mongodb://127.0.0.1:27017/kidsstore
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Auth
ACCESS_TOKEN=replace-with-a-long-random-string
REFRESH_TOKEN=replace-with-another-long-random-string

# Email (optional, used for notifications)
SMTP_USER=
SMTP_PASS=

# SMS / OTP (optional; OTP codes are logged in development when unset)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE_ID=

# Online payments (optional; cash on delivery works without it)
PAYMENT_REQUEST_URL=
PAYMENT_VERIFY_URL=
PAYMENT_START_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/verify
PAYMENT_AMOUNT_MULTIPLIER=100

# Store settings
SHIPPING_COST=5
FREE_SHIPPING_OVER=75

# Order automation
ORDER_SWEEP_MINUTES=10
ORDER_ABANDON_MINUTES=30
ORDER_COD_REMIND_DAYS=3
ORDER_AUTO_COMPLETE_DAYS=14
ORDER_AUTO_COMPLETE_AFTER_ETA_DAYS=3
DISABLE_ORDER_SWEEPER=false
CRON_SECRET=replace-with-a-random-string
